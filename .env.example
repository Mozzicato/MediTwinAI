# `demo` is the synthetic scenario. `clinical` fails closed until every required
# server-side dependency below has been configured and verified.
MEDITWIN_APP_MODE=demo

# Turso-backed local demo accounts. Set a long random secret for any hosted demo.
# Use TURSO_AUTH_TOKEN with the libsql URL. Do not expose either variable to the browser.
TURSO_AUTH_TOKEN=
LOCAL_AUTH_SESSION_SECRET=replace-with-a-long-random-value

# Clinical mode requirements: never expose these to the browser.
DATABASE_URL=
AUTH_PROVIDER_URL=
AUTH_PROVIDER_SECRET=
ONTOMORPH_API_KEY=
ONTOMORPH_GRANT_TOKEN=
ONTOMORPH_BASE_URL=
HOLON_API_KEY=
HOLON_BASE_URL=
LLM_API_KEY=

# Leave blank to use same-origin API routes. Set only for local FastAPI development.
NEXT_PUBLIC_API_BASE_URL=