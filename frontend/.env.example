# Next.js loads local variables from this directory. Copy to .env.local for local development.
# Set these as server-side environment variables in Vercel.
MEDITWIN_APP_MODE=demo
DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
LOCAL_AUTH_SESSION_SECRET=replace-with-a-long-random-value

# Leave blank to use same-origin API routes.
NEXT_PUBLIC_API_BASE_URL=