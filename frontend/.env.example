# Copy to frontend/.env.local for local development, or set these as server-side environment
# variables in Vercel. Never prefix any of them with NEXT_PUBLIC_.

# `demo` serves synthetic OntoMorph sandbox twins. `clinical` fails closed (see docs/CLINICAL_LAUNCH.md).
MEDITWIN_APP_MODE=demo

# OntoMorph Digital Twin Platform key (dtp_live_… or dtp_test_…) — sent as X-DTP-API-Key.
# DTP_LIVE_PERSONAL is accepted as an alias for the same value.
ONTOMORPH_API_KEY=
# Optional overrides
ONTOMORPH_SANDBOX_URL=https://sandbox-api.ontomorph.com

# HOLON clinical-knowledge key (holon_…) — sent as Authorization: Bearer.
HOLON_API_KEY=
HOLON_BASE_URL=https://holon-api.ontomorph.com

# Optional AI for plain-language explanations and free-text symptoms. Groq is used when set;
# ANTHROPIC_API_KEY takes priority if both are present. Without either, MediTwin uses its
# reviewed templates and keyword matching. Every AI answer passes citation and safety checks.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
# MEDITWIN_CLAUDE_MODEL=claude-opus-5

# Optional demo accounts (Turso / libSQL). The demo works without them.
DATABASE_URL=
TURSO_AUTH_TOKEN=
LOCAL_AUTH_SESSION_SECRET=replace-with-a-long-random-value

# Clinical mode only
AUTH_PROVIDER_URL=
AUTH_PROVIDER_SECRET=
CLINICAL_CONTENT_APPROVAL_ID=

# Leave blank to use same-origin API routes.
NEXT_PUBLIC_API_BASE_URL=
